<?xml version="1.0" encoding="utf-8"?>
<packages>
  <!-- System.Data.SQLite.Core is an empty meta-package as of 1.0.116+; the real
       .NET Framework assets (managed DLL + native SQLite.Interop.dll) live in
       Stub.System.Data.SQLite.Core.NetFramework, which is what's actually referenced
       in PhotoStudioApp.csproj. This file is kept for documentation/Visual Studio's
       NuGet UI - the build scripts and CI workflow restore this package by direct
       download rather than "nuget restore", since that proved unreliable in CI. -->
  <package id="Stub.System.Data.SQLite.Core.NetFramework" version="1.0.118" targetFramework="net46" />
  <package id="Microsoft.NETFramework.ReferenceAssemblies.net46" version="1.0.3" targetFramework="net46" developmentDependency="true" />
</packages>
