  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />

  <!-- Best-effort: the Stub package's own build target, if MSBuild honors it. -->
  <Import Project="$(SQLiteStubPackageDir)Stub.System.Data.SQLite.Core.NetFramework.targets" Condition="Exists('$(SQLiteStubPackageDir)Stub.System.Data.SQLite.Core.NetFramework.targets')" />

  <!-- Diagnostic only - prints what the .NET 4.6 reference-assemblies override actually
       resolved to, right before GetReferenceAssemblyPaths runs. If MSB3644 ever reappears,
       this shows in the build log exactly which path was checked and whether it existed,
       instead of having to guess blind again. Importance="high" so it shows even without -v. -->
  <Target Name="DiagnoseNetFx46RefAssemblies" BeforeTargets="GetReferenceAssemblyPaths">
    <PropertyGroup>
      <_NetFx46ResolvedRefDir>$(TargetFrameworkRootPath).NETFramework\v4.6\</_NetFx46ResolvedRefDir>
    </PropertyGroup>
    <ItemGroup>
      <_NetFx46MscorlibCheck Include="$(_NetFx46ResolvedRefDir)mscorlib.dll" Condition="Exists('$(_NetFx46ResolvedRefDir)mscorlib.dll')" />
    </ItemGroup>
    <Message Importance="high" Text="[diag] MSBuildProjectDirectory        = $(MSBuildProjectDirectory)" />
    <Message Importance="high" Text="[diag] NetFx46RefAssembliesPackageDir = $(NetFx46RefAssembliesPackageDir)" />
    <Message Importance="high" Text="[diag] TargetFrameworkRootPath        = $(TargetFrameworkRootPath)" />
    <Message Importance="high" Text="[diag] Resolved ref assemblies dir    = $(_NetFx46ResolvedRefDir)" />
    <Message Importance="high" Text="[diag] Dir exists (System.IO check)   = $([System.IO.Directory]::Exists('$(_NetFx46ResolvedRefDir)'))" />
    <Message Importance="high" Text="[diag] mscorlib.dll found (Exists())  = @(_NetFx46MscorlibCheck->Count()) match(es)" />
  </Target>

  <!-- Guaranteed fallback: this package's own copy-to-output target is known to be flaky
       in headless/CI builds (silently skips copying SQLite.Interop.dll in some MSBuild
       versions - see sqlite.org forum discussions on this exact package). Rather than
       depend on that working, copy the native interop DLLs to the output's x86\ and x64\
       subfolders ourselves, every build, unconditionally. App.config's <probing> element
       already tells the runtime to look in x86\ and x64\ next to the exe. -->
  <Target Name="CopySQLiteInteropFilesOurselves" AfterTargets="Build;Rebuild">
    <ItemGroup>
      <_SQLiteInteropX86 Include="$(SQLiteStubPackageDir)x86\SQLite.Interop.dll" Condition="Exists('$(SQLiteStubPackageDir)x86\SQLite.Interop.dll')" />
      <_SQLiteInteropX64 Include="$(SQLiteStubPackageDir)x64\SQLite.Interop.dll" Condition="Exists('$(SQLiteStubPackageDir)x64\SQLite.Interop.dll')" />
    </ItemGroup>
    <MakeDir Directories="$(OutDir)x86" Condition="'@(_SQLiteInteropX86)' != ''" />
    <MakeDir Directories="$(OutDir)x64" Condition="'@(_SQLiteInteropX64)' != ''" />
    <Copy SourceFiles="@(_SQLiteInteropX86)" DestinationFolder="$(OutDir)x86\" Condition="'@(_SQLiteInteropX86)' != ''" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_SQLiteInteropX64)" DestinationFolder="$(OutDir)x64\" Condition="'@(_SQLiteInteropX64)' != ''" SkipUnchangedFiles="true" />
    <Warning Text="SQLite.Interop.dll not found under $(SQLiteStubPackageDir)x86 or x64 - the app will fail at runtime when it opens the database. Check that the Stub.System.Data.SQLite.Core.NetFramework package was restored correctly." Condition="'@(_SQLiteInteropX86)' == '' and '@(_SQLiteInteropX64)' == ''" />
  </Target>
</Project>
