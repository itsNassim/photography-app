<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x86</Platform>
    <ProjectGuid>{A1B2C3D4-1111-2222-3333-444455556666}</ProjectGuid>
    <OutputType>WinExe</OutputType>
    <RootNamespace>PhotoStudioApp</RootNamespace>
    <AssemblyName>PhotoStudioApp</AssemblyName>
    <!-- IMPORTANT: keep at 4.8. Do NOT upgrade to .NET 5+/Core — those dropped Windows 7 support. -->
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <Deterministic>true</Deterministic>
    <ApplicationIcon>Properties\app.ico</ApplicationIcon>
    <!-- As of System.Data.SQLite.Core 1.0.116+, that package is an empty meta-package -
         the actual managed DLL and native SQLite.Interop.dll live in
         Stub.System.Data.SQLite.Core.NetFramework instead. This property points at it;
         see the Reference below and the CopySQLiteInteropFiles target near the bottom
         of this file, which copies the native DLL ourselves instead of relying on that
         package's own build target (which has known flakiness in headless/CI builds). -->
    <SQLiteStubPackageDir>..\packages\Stub.System.Data.SQLite.Core.NetFramework.1.0.118\build\net46\</SQLiteStubPackageDir>
    <ContentSQLiteInteropFiles>true</ContentSQLiteInteropFiles>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x86' ">
    <PlatformTarget>x86</PlatformTarget>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x86' ">
    <PlatformTarget>x86</PlatformTarget>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Data" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
    <!-- Restored directly (not via "nuget restore") from Stub.System.Data.SQLite.Core.NetFramework -
         the package that actually contains the .NET Framework assets. See SQLiteStubPackageDir above. -->
    <Reference Include="System.Data.SQLite">
      <HintPath>..\packages\Stub.System.Data.SQLite.Core.NetFramework.1.0.118\lib\net46\System.Data.SQLite.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Models\Category.cs" />
    <Compile Include="Models\StockItem.cs" />
    <Compile Include="Models\CustomCharge.cs" />
    <Compile Include="Models\DailyClose.cs" />
    <Compile Include="Models\AppSettings.cs" />
    <Compile Include="Data\Db.cs" />
    <Compile Include="Data\SchemaInitializer.cs" />
    <Compile Include="Data\CategoryRepository.cs" />
    <Compile Include="Data\StockRepository.cs" />
    <Compile Include="Data\CustomChargeRepository.cs" />
    <Compile Include="Data\DailyCloseRepository.cs" />
    <Compile Include="Data\SettingsRepository.cs" />
    <Compile Include="Services\PasswordService.cs" />
    <Compile Include="Services\FolderCountService.cs" />
    <Compile Include="Services\ClosingService.cs" />
    <Compile Include="Services\ReportPrintService.cs" />
    <Compile Include="Services\WorkdayCalculator.cs" />
    <Compile Include="Services\AppCulture.cs" />
    <Compile Include="UI\Theme.cs" />
    <Compile Include="UI\AuthGate.cs" />
    <Compile Include="UI\MainForm.cs" />
    <Compile Include="UI\HomeTab.cs" />
    <Compile Include="UI\StockTab.cs" />
    <Compile Include="UI\CategoriesTab.cs" />
    <Compile Include="UI\HistoryTab.cs" />
    <Compile Include="UI\SettingsTab.cs" />
    <Compile Include="UI\Dialogs\AddEditCategoryDialog.cs" />
    <Compile Include="UI\Dialogs\AddEditStockDialog.cs" />
    <Compile Include="UI\Dialogs\AddCustomChargeDialog.cs" />
    <Compile Include="UI\Dialogs\PasswordPromptDialog.cs" />
    <Compile Include="UI\Dialogs\SetPasswordDialog.cs" />
    <Compile Include="UI\Dialogs\BreakdownReportForm.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="App.config" />
    <None Include="packages.config" />
    <Content Include="Properties\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />

  <!-- Best-effort: the Stub package's own build target, if MSBuild honors it. -->
  <Import Project="$(SQLiteStubPackageDir)Stub.System.Data.SQLite.Core.NetFramework.targets" Condition="Exists('$(SQLiteStubPackageDir)Stub.System.Data.SQLite.Core.NetFramework.targets')" />

  <!-- Guaranteed fallback: this package's own copy-to-output target is known to be flaky
       in headless/CI builds (silently skips copying SQLite.Interop.dll in some MSBuild
       versions - see sqlite.org forum discussions on this exact package). Rather than
       depend on that working, copy the native interop DLLs to the output's x86\ and x64\
       subfolders ourselves, every build, unconditionally. App.config's <probing> element
       already tells the runtime to look in x86\ and x64\ next to the exe. -->
  <Target Name="CopySQLiteInteropFilesOurselves" AfterTargets="Build;Rebuild">
    <ItemGroup>
      <_SQLiteInteropX86 Include="$(SQLiteStubPackageDir)x86\SQLite.Interop.dll" Condition="Exists('$(SQLiteStubPackageDir)x86\SQLite.Interop.dll')" />
      <_SQLiteInteropX64 Include="$(SQLiteStubPackageDir)x64\SQLite.Interop.dll" Condition="Exists('$(SQLiteStubPackageDir)x64\SQLite.Interop.dll')" />
    </ItemGroup>
    <MakeDir Directories="$(OutDir)x86" Condition="'@(_SQLiteInteropX86)' != ''" />
    <MakeDir Directories="$(OutDir)x64" Condition="'@(_SQLiteInteropX64)' != ''" />
    <Copy SourceFiles="@(_SQLiteInteropX86)" DestinationFolder="$(OutDir)x86\" Condition="'@(_SQLiteInteropX86)' != ''" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_SQLiteInteropX64)" DestinationFolder="$(OutDir)x64\" Condition="'@(_SQLiteInteropX64)' != ''" SkipUnchangedFiles="true" />
    <Warning Text="SQLite.Interop.dll not found under $(SQLiteStubPackageDir)x86 or x64 - the app will fail at runtime when it opens the database. Check that the Stub.System.Data.SQLite.Core.NetFramework package was restored correctly." Condition="'@(_SQLiteInteropX86)' == '' and '@(_SQLiteInteropX64)' == ''" />
  </Target>
</Project>
